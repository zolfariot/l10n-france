<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="l10n_fr_account_vat_return_deductible_detail_form"
        model="ir.ui.view"
    >
        <field name="name">Detailed Deductible VAT Report</field>
        <field
            name="model"
        >l10n.fr.account.vat.return.deductible.detail</field>
        <field name="arch" type="xml">
            <form string="Detailed Deductible VAT Report">
                <group>
                    <field name="return_id" readonly="1" />
                    <field name="box_choice" />
                </group>
                <footer>
                    <button
                        name="generate_xlsx"
                        type="object"
                        string="Generate XLSX"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_l10n_fr_account_vat_return_deductible_detail"
        model="ir.actions.act_window"
    >
        <field name="name">Detailed Deductible VAT Report</field>
        <field
            name="res_model"
        >l10n.fr.account.vat.return.deductible.detail</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_return_id': active_id}</field>
    </record>
</odoo>
